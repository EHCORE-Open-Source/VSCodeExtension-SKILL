{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/completion.schema",
    "version": 1.0,
    "release": "2025/10/09",
    "author": "Chao-Jen Huang (ephoton)",
    "title": "Automatic Completion",
    "description": "Schema for automatic completion of SKILL language extensions.",
    "type": "object",
    "properties": {
        "$schema": {
            "description": "The JSON schema version",
            "type": "string"
        },
        "version": {
            "description": "Define the library file format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the library",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the library",
            "type": "string"
        },
        "datatype": {
            "$ref": "#/definitions/datatype"
        },
        "functions": {
            "$ref": "#/definitions/functions"
        }
    },
    "definitions": {
        "datatype": {
            "type": "object",
            "patternProperties": {
                "^[a-zA-Z&]+$": {
                    "type": "object",
                    "properties": {
                        "internal": {
                            "description": "The internal name of the datatype",
                            "type": "string"
                        },
                        "type": {
                            "description": "The datatype",
                            "type": "string"
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "internal",
                        "type"
                    ]
                }
            },
            "additionalProperties": false
        },
        "functions": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "comment": {
                        "description": "The comment of the function",
                        "type": "string"
                    },
                    "definitions": {
                        "type": "object",
                        "patternProperties": {
                            "^.+$": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/definitions/function_definition"
                                }
                            }
                        }
                    }
                },
                "additionalProperties": false
            }
        },
        "function_definition": {
            "type": "object",
            "properties": {
                "name_collection": {
                    "description": "The name of the collection",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "argument_combination": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "arguments": {
                                "description": "The arguments of the function",
                                "type": "object",
                                "patternProperties": {
                                    "^.+$": {
                                        "type": "string",
                                        "description": "The description of the argument"
                                    }
                                },
                                "additionalProperties": false
                            },
                            "return": {
                                "description": "The return value of the function",
                                "type": "object",
                                "patternProperties": {
                                    "^.+$": {
                                        "type": "string",
                                        "description": "The description of the return value"
                                    }
                                },
                                "additionalProperties": false
                            }
                        }
                    }
                },
                "description": {
                    "description": "The description of the function",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false,
            "required": [
                "name_collection",
                "argument_combination",
                "description"
            ]
        }
    },
    "additionalProperties": false
}