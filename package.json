{
  "name": "cadence-skill-support-package",
  "displayName": "Cadence SKILL Extension",
  "description": "Cadence SKILL language support",
  "version": "0.0.1",
  "publisher": "Chao-Hen Huang",
  "private": "false",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EHCORE-Open-Source/VSCodeExtension-SKILL.git"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cadence-skill",
        "aliases": [
          "Cadence SKILL", 
          "SKILL"
        ],
        "extensions": [
          ".il"
        ],
        "configuration": "./syntax/skill/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cadence-skill",
        "scopeName": "source.cadence.skill",
        "path": "./syntax/skill/tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.19",
    "@types/vscode": "^1.86.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.3.9",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  }
}
