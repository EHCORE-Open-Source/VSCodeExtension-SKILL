{
  "name": "cadence-skill-support-package",
  "displayName": "Cadence SKILL Extension",
  "description": "Cadence SKILL language support",
  "version": "0.0.10",
  "publisher": "ephoton0210-taiwan",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EHCORE-Open-Source/VSCodeExtension-SKILL.git"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cadence-skill",
        "aliases": [
          "SKILL"
        ],
        "extensions": [
          ".il",
          ".cdsinit"
        ],
        "configuration": "./syntax/skill/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cadence-skill",
        "scopeName": "source.cadence.skill.basic",
        "path": "./syntax/skill/basic.tmLanguage.json"
      },
      {
        "scopeName": "source.cadence.skill.function",
        "path": "./syntax/skill/function.tmLanguage.json"
      },
      {
        "scopeName": "markdown.cadence.skill.codeblock",
        "path": "./syntax/skill/markdown-injection.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.skill": "cadence-skill"
        }
      },
      {
        "scopeName": "embedded.cadence.skill.comment",
        "path": "./syntax/skill/embedded-language-injection.tmLanguage.json",
        "injectTo": [
          "source.cadence.skill.basic"
        ],
        "embeddedLanguages": {
          "source.yaml": "yaml",
          "text.html.markdown": "markdown",
          "source.json": "json"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && copyfiles -u 2 src/builtin-procedures/databases/*.json out/builtin-procedures/databases && copyfiles docs/complete-skill-functions.json out/docs",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=\"Mobile Chrome\"",
    "test:report": "playwright show-report",
    "test:codegen": "playwright codegen",
    "puppeteer:run": "node tests/puppeteer-tests.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vscode/test-cli": "^0.0.6",
    "@vscode/test-electron": "^2.3.9",
    "copyfiles": "^2.4.1",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.1",
    "playwright-lighthouse": "^4.0.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vscode": "^1.1.34"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/openai": "^0.6.14",
    "langchain": "^0.3.35",
    "openai": "^6.3.0",
    "puppeteer": "^24.24.0"
  }
}