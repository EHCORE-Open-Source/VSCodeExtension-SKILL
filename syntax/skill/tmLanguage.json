                {
                    "comment": "Data Operator Functions (Letter o)",
                    "match": "\\b(otherp)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Operator Functions (Letter p)",
                    "match": "\\b(plist|popf|post(?:Array(?:Dec|Inc|Set)|(?:de|in)crement)|pre(?:Array(?:Dec|Inc|Set)|(?:de|in)crement)|pushf|putprop(?:qq?)?)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Operator Functions (Letter q)",
                    "match": "\\b(quote)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Operator Functions (Letter r)",
                    "match": "\\b(remprop|rotatef)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Operator Functions (Letter s)",
                    "match": "\\b(setf?(?:_(?:arrayref|c[ad]{1,3}r|get(?:SGq?|ShellEnvVar|[dq]|qq)?|last|(?:left|right|top|bottom)Edge|lowerLeft|nth(?:[ce]dr|elem)?|slotValue|upperRight|[xy]Coord|([[:word:]]+)))?|set(?:guard|plist|q|SG)|symbolp|sym(?:eval|strp))\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        },
                        "2": {
                            "name": "strong.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Operator Functions (Extension)",
