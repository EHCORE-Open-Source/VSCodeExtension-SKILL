                            "name": "keyword.control.cadence.skill.basic"
                        },
                        "2": {
                            "name": "strong.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Type Conversion Functions",
                    "match": "\\b(charToInt|intToChar|listToVector|stringTo(?:Function|Symbol|Time)|symbolToString|tableToList|timeTo(?:String|Tm)|tmToTime|vectorToList)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "String Functions (Letter b)",
                    "match": "\\b(blankstrp|buildString)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "String Functions (Letter g)",
                    "match": "\\b(getchar)\\b",
                    "captures": {
