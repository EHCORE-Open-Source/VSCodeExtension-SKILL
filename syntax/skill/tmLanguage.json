{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "cadence-skill",
    "scopeName": "source.cadence.skill",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numeric"
        },
        {
            "include": "#keyword"
        },
        {
            "include": "#function"
        }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "comment": "block comment",
                    "name": "comment.block.cadence.skill.basic",
                    "begin": "/\\*",
                    "end": "\\*/"
                },
                {
                    "comment": "line comment",
                    "name": "comment.block.cadence.skill.basic",
                    "match": ";\\s*(\\bTODO\\b)?.*",
                    "captures": {
                        "1": {
                            "name": "markup.bold.cadence.skill.basic"
                        }
                    }
                }
            ]
        },
        "numeric": {
            "patterns": [
                {
                    "comment": "octal numeric notation",
                    "name": "constant.numeric.cadence.skill.octal",
                    "match": "\\b-?(0)[0-7]+\\b",
                    "captures": {
                        "1": {
                            "name": "strong.cadence.skill.octal"
                        }
                    }
                },
                {
                    "comment": "hexadecimal numeric notation",
                    "name": "constant.numeric.cadence.skill.hexadecimal",
                    "match": "\\b(?i)-?(0x)[0-9a-f]+\\b",
                    "captures": {
                        "1": {
                            "name": "strong.cadence.skill.hexadecimal"
                        }
                    }
                },
                {
                    "comment": "binary numeric notation",
                    "name": "constant.numeric.cadence.skill.binary",
                    "match": "\\b(?i)-?(0b)[01]+\\b",
                    "captures": {
                        "1": {
                            "name": "strong.cadence.skill.binary"
                        }
                    }
                },
                {
                    "comment": "numeric for scientific or symbol notation",
                    "name": "constant.numeric.cadence.skill.basic",
                    "match": "\\b-?[0-9]+(?:\\.[0-9]+)?([eE][+-]?[0-9]+|[TGMKkmunpfa])?\\b",
                    "captures": {
                        "1": {
                            "name": "strong.cadence.skill.basic"
                        }
                    }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "double quotes",
                    "name": "string.quoted.double.cadence.skill.basic",
                    "begin": "\\\"", 
                    "end": "\\\"",
		            "patterns": [
                        {
                            "comment": "white space characters",
                            "name": "constant.character.escape.cadence.skill.basic",
                            "match": "\\\\[tfrnv]"
                        },
                        {
                            "comment": "common output format specifications",
                            "name": "support.variable.cadence.skill.basic",
                            "match": "\\%(?:-?[[:digit:]]*(?:\\.[[:digit:]]+)?[doxfegsnNA]|[LPB])"
                        }
                    ]	
                }
            ]
        },
        "keyword": {
            "patterns": [
                {
                    "comment": "boolean",
                    "match": "\\b(t|nil)\\b",
                    "captures": {
                        "1": {
                            "name": "constant.language.cadence.skill.basic"
                        }
                    }
                }
            ]
        },
        "function": {
            "patterns": [
                {
                    "comment": "functions",
                    "match": "\\b([[:word:]]+)\\(",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#builtin_function"
                                },
                                {
                                    "include": "#other_function"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "builtin_function": {
            "patterns": [
                {
                    "comment": "List Functions (Letter a)",
                    "match": "\\b(append1?)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter c)",
                    "match": "\\b(c[ad]{1,4}r|cons(?:tar)?|copy)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter d)",
                    "match": "\\b(dtpr)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter l)",
                    "match": "\\b(last|lconc|length|lindex|listp?)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter n)",
                    "match": "\\b(ncon[cs]|nth(?:cdr|elem)?)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter p)",
                    "match": "\\b(pairp)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter r)",
                    "match": "\\b(range|rem(?:d|dq|q)|remove(?:ListDuplicates)?|reverse|rplac[ad])\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter s)",
                    "match": "\\b(setc[ad]r)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter t)",
                    "match": "\\b(tailp|tconc)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter [xy])",
                    "match": "\\b(xcons|[xy]Coord)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Structures (Letter a)",
                    "match": "\\b(array(?:p|ref)?|ass(?:oc|[qv]))\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Structures (Letter d)",
                    "match": "\\b(declare|def(?:prop|structp?|var))\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Structures (Letter m)",
                    "match": "\\b(make(?:Table|Vector))\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Structures (Letter s)",
                    "match": "\\b(setarray)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Structures (Letter t)",
