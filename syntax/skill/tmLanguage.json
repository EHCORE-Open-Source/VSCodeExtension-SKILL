                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Structures (Letter v)",
                    "match": "\\b(vectorp?)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Operator Functions (Letter a)",
                    "match": "\\b(alphaNumCmp)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Operator Functions (Letter c)",
                    "match": "\\b(concat|copyDefstructDeep)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Operator Functions (Letter g)",
                    "match": "\\b(get(?:SG|qq?)?)\\b",
