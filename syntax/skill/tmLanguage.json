{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "cadence-skill",
    "scopeName": "source.cadence.skill",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numeric"
        },
        {
            "include": "#keyword"
        },
        {
            "include": "#function"
        }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "comment": "block comment",
                    "name": "comment.block.cadence.skill.basic",
                    "begin": "/\\*",
                    "end": "\\*/"
                },
                {
                    "comment": "line comment",
                    "name": "comment.block.cadence.skill.basic",
                    "match": ";.*"
                }
            ]
        },
        "numeric": {
            "patterns": [
                {
                    "comment": "numeric for scientific or symbol notation",
                    "name": "constant.numeric.cadence.skill.basic",
                    "match": "(^|[;=\\s])[+-]?[0-9_]+(\\.[0-9_]+)?([eE][+-]?[0-9_]+|[TGMKkmunpfa])?($|[;\\s])"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "comment": "double quotes",
                    "name": "string.quoted.double.cadence.skill.basic",
                    "begin": "\\\"", 
                    "end": "\\\"",
		            "patterns": [
                        {
                            "name": "constant.character.escape.cadence.skill.basic",
                            "match": "\\\\([nt\\x5C\\x22]|[01]?[0-7]{1,2})"
                        }
                    ]
                     	
                }
            ]
        },
        "keyword": {
            "patterns": [
                {
                    "comment": "List Functions (Letter a)",
                    "match": "\\b(append1?)\\(",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter c)",
                    "match": "\\b(c[ad]{1,4}r|cons(?:tar)?|copy)\\(",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter d)",
                    "match": "\\b(dtpr)\\(",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter l)",
                    "match": "\\b(last|lconc|length|lindex|listp?)\\(",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter n)",
                    "match": "\\b(ncon[cs]|nth(?:cdr|elem)?)\\(",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter p)",
                    "match": "\\b(pairp)\\(",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter r)",
                    "match": "\\b(range|rem(?:d|dq|q)|remove(?:ListDuplicates)?|reverse|rplac[ad])\\(",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "List Functions (Letter s)",
                    "match": "\\b(setc[ad]r)\\(",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
