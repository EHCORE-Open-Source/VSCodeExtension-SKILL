                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "String Functions (Letter s)",
                    "match": "\\b(sprintf|str(?:n?cat|n?cmp|len|pbrk)|stringp|sub(?:st|string))\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "String Functions (Letter o)",
                    "match": "\\b(outstringp)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "String Functions (Index)",
                    "match": "\\b([nr]?index)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "String Functions (Case)",
                    "match": "\\b((?:lower|upper)Case)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "String Functions (Regular Expression)",
                    "match": "\\b(rex(?:Compile|Execute|Magic|Match(?:Assoc)?List|Matchp|Replace|Substitute))\\b",
