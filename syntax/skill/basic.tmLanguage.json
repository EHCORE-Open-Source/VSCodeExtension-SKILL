{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "cadence-skill",
  "scopeName": "source.cadence.skill.basic",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#specialSpecification"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numeric"
    },
    {
      "include": "#flavor"
    },
    {
      "include": "source.cadence.skill.function"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#parameter"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "comment": "block comment",
          "name": "comment.block.cadence.skill.basic",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "match": "\\b(TODO)\\b",
              "name": "markup.bold.cadence.skill.basic"
            }
          ]
        },
        {
          "comment": "line comment",
          "name": "comment.block.cadence.skill.basic",
          "match": ";(.*)",
          "captures": {
            "1": {
              "patterns": [
                {
                  "match": "\\b(TODO)\\b",
                  "name": "markup.bold.cadence.skill.basic"
                }
              ]
            }
          }
        }
      ]
    },
    "numeric": {
      "patterns": [
        {
          "comment": "octal numeric notation",
          "name": "constant.numeric.cadence.skill.octal",
          "match": "\\b-?(0)[0-7]+\\b",
          "captures": {
            "1": {
              "name": "strong.cadence.skill.octal"
            }
          }
        },
        {
          "comment": "hexadecimal numeric notation",
          "name": "constant.numeric.cadence.skill.hexadecimal",
          "match": "\\b(?i)-?(0x)[0-9a-f]+\\b",
          "captures": {
            "1": {
              "name": "strong.cadence.skill.hexadecimal"
            }
          }
        },
        {
          "comment": "binary numeric notation",
          "name": "constant.numeric.cadence.skill.binary",
          "match": "\\b(?i)-?(0b)[01]+\\b",
          "captures": {
            "1": {
              "name": "strong.cadence.skill.binary"
            }
          }
        },
        {
          "comment": "numeric for scientific or symbol notation",
          "name": "constant.numeric.cadence.skill.basic",
          "match": "\\b-?[0-9]+(?:\\.[0-9]+)?([eE][+-]?[0-9]+|[TGMKkmunpfa%])?\\b",
          "captures": {
            "1": {
              "name": "strong.cadence.skill.basic"
            }
          }
        }
      ]
    },
    "specialSpecification": {
      "patterns": [
        {
          "comment": "double quotes",
          "begin": "(?<=\\b[fs]?scanf\\()",
          "end": "(?=\\))",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#inputSpecification"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numeric"
            },
            {
              "include": "#flavor"
            },
            {
              "include": "source.cadence.skill.function"
            },
            {
              "include": "#keyword"
            },
            {
              "include": "#parameter"
            }
          ]
        },
        {
          "comment": "double quotes",
          "begin": "(?<=\\b[fs]?printf\\()",
          "end": "(?=\\))",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#outputSpecification"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numeric"
            },
            {
              "include": "#flavor"
            },
            {
              "include": "source.cadence.skill.function"
            },
            {
              "include": "#keyword"
            },
            {
              "include": "#parameter"
            }
          ]
        },
        {
          "comment": "PCRE functions - first string parameter only",
          "begin": "(?<=\\bpcre(Compile|MatchAssocList|MatchList|Matchp)\\()\\s*(?=\")",
          "end": "(?<=\")",
          "patterns": [
            {
              "include": "#pcreSpecification"
            }
          ]
        },
        {
          "comment": "REX functions - first string parameter only",
          "begin": "(?<=\\brex(Compile|MatchAssocList|MatchList|Matchp)\\()\\s*(?=\")",
          "end": "(?<=\")",
          "patterns": [
            {
              "include": "#rexSpecification"
            }
          ]
        }
      ]
    },
    "inputSpecification": {
      "patterns": [
        {
          "name": "string.quoted.double.cadence.skill.input.specification",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "comment": "white space characters",
              "name": "constant.character.escape.cadence.skill.basic strong.cadence.skill.escape",
              "match": "\\\\[tfrnv]"
            },
            {
              "comment": "special characters",
              "name": "constant.character.escape.cadence.skill.special",
              "match": "\\\\(\\\\|\")"
            },
            {
              "comment": "common input format specifications",
              "name": "support.variable.cadence.skill.input.specification",
              "match": "\\%(-?[[:digit:]]*(?:\\.[[:digit:]]+)?)[dfseg]",
              "captures": {
                "1": {
                  "name": "strong.cadence.skill.input.specification"
                }
              }
            }
          ]
        }
      ]
    },
    "outputSpecification": {
      "patterns": [
        {
          "name": "string.quoted.double.cadence.skill.output.specification",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "comment": "white space characters",
              "name": "constant.character.escape.cadence.skill.basic strong.cadence.skill.escape",
              "match": "\\\\[tfrnv]"
            },
            {
              "comment": "special characters",
              "name": "constant.character.escape.cadence.skill.special",
              "match": "\\\\(\\\\|\")"
            },
            {
              "comment": "common output format specifications",
              "name": "support.variable.cadence.skill.output.specification",
              "match": "\\%(?:(-?[[:digit:]]*(?:\\.[[:digit:]]+)?)[doxfegsnNA]|[LPB])",
              "captures": {
                "1": {
                  "name": "strong.cadence.skill.output.specification"
                }
              }
            }
          ]
        }
      ]
    },
    "pcreSpecification": {
      "patterns": [
        {
          "comment": "PCRE double quoted string",
          "name": "string.quoted.double.cadence.skill.pcre",
          "begin": "(\")(\\^)?",
          "end": "(\\$)?(\")",
          "beginCaptures": {
            "1": {
              "name": "string.quoted.double.cadence.skill.pcre.begin"
            },
            "2": {
              "name": "comment.line.number-sign.cadence.skill.pcre.begin"
            }
          },
          "endCaptures": {
            "1": {
              "name": "comment.line.number-sign.cadence.skill.pcre.end"
            },
            "2": {
              "name": "string.quoted.double.cadence.skill.pcre.end"
            }
          },
          "patterns": [
            {
              "include": "#pcreKeyword"
            },
            {
              "include": "#pcreCharset"
            },
            {
              "comment": "PCRE quantifiers and metacharacters",
              "name": "entity.name.tag strong.cadence.skill.pcre.operator",
              "match": "[+*.?|]"
            }
          ]
        }
      ]
    },
    "pcreCharset": {
      "patterns": [
        {
          "comment": "PCRE character set",
          "begin": "(\\[)(\\^)?",
          "end": "(\\])",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.character-class.begin.cadence.skill.pcre keyword.operator.cadence.skill.pcre.charset"
            },
            "2": {
              "name": "keyword.operator.negation.cadence.skill.pcre.charset"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.character-class.end.cadence.skill.pcre keyword.operator.cadence.skill.pcre.charset"
            }
          },
          "patterns": [
            {
              "comment": "POSIX character class",
              "name": "support.constant.cadence.skill.pcre.posix",
              "match": "\\[:(?:alnum|alpha|ascii|blank|cntrl|x?digit|graph|lower|print|punct|space|upper|word):\\]"
            },
            {
              "comment": "Character range with full underline (including octal sequences)",
              "match": "(\\\\\\\\(?:[0-3][0-7]{2}|[0-7]{1,2})|\\\\\\\\.|[^\\]\\\\-])(-)(\\\\\\\\(?:[0-3][0-7]{2}|[0-7]{1,2})|\\\\\\\\.|[^\\]\\\\-])",
              "name": "markup.underline.cadence.skill.pcre.range",
              "captures": {
                "2": {
                  "name": "keyword.operator.range.cadence.skill.pcre.charset"
                }
              }
            },
            {
              "comment": "Escaped character in charset",
              "name": "string.regexp.escape.cadence.skill.pcre.charset",
              "match": "\\\\\\\\."
            }
          ]
        }
      ]
    },
    "pcreKeyword": {
      "patterns": [
        {
          "include": "#pcreGroupLevel1"
        },
        {
          "include": "#pcreKeywordBase"
        }
      ]
    },
    "pcreGroupLevel1": {
      "patterns": [
        {
          "comment": "PCRE non-capturing group - Level 1",
          "begin": "(\\()(\\?:)",
          "end": "(\\))",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            },
            "2": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill strong.cadence.skill.pcre.group.level1"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            }
          },
          "patterns": [
            {
              "include": "#pcreGroupLevel2"
            },
            {
              "include": "#pcreKeywordBase"
            },
            {
              "include": "#pcreCharset"
            }
          ]
        },
        {
          "comment": "PCRE positive lookahead - Level 1",
          "begin": "(\\()(\\?=)",
          "end": "(\\))",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            },
            "2": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill strong.cadence.skill.pcre.lookahead.level1"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            }
          },
          "patterns": [
            {
              "include": "#pcreGroupLevel2"
            },
            {
              "include": "#pcreKeywordBase"
            },
            {
              "include": "#pcreCharset"
            }
          ]
        },
        {
          "comment": "PCRE negative lookahead - Level 1",
          "begin": "(\\()(\\?!)",
          "end": "(\\))",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            },
            "2": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill strong.cadence.skill.pcre.lookahead.level1"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            }
          },
          "patterns": [
            {
              "include": "#pcreGroupLevel2"
            },
            {
              "include": "#pcreKeywordBase"
            },
            {
              "include": "#pcreCharset"
            }
          ]
        },
        {
          "comment": "PCRE positive lookbehind - Level 1",
          "begin": "(\\()(\\?<=)",
          "end": "(\\))",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            },
            "2": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill strong.cadence.skill.pcre.lookbehind.level1"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            }
          },
          "patterns": [
            {
              "include": "#pcreGroupLevel2"
            },
            {
              "include": "#pcreKeywordBase"
            },
            {
              "include": "#pcreCharset"
            }
          ]
        },
        {
          "comment": "PCRE negative lookbehind - Level 1",
          "begin": "(\\()(\\?<!)",
          "end": "(\\))",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            },
            "2": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill strong.cadence.skill.pcre.lookbehind.level1"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            }
          },
          "patterns": [
            {
              "include": "#pcreGroupLevel2"
            },
            {
              "include": "#pcreKeywordBase"
            },
            {
              "include": "#pcreCharset"
            }
          ]
        },
        {
          "comment": "PCRE flags and modifiers - Level 1",
          "name": "keyword.control.bracket.pcre.level1.cadence.skill strong.cadence.skill.pcre.flag.level1",
          "match": "\\(\\?-?[imsx]+\\)"
        },
        {
          "comment": "PCRE regular capturing group - Level 1",
          "begin": "(\\()",
          "end": "(\\))",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.bracket.pcre.level1.cadence.skill"
            }
          },
          "patterns": [
            {
              "include": "#pcreGroupLevel2"
            },
            {
              "include": "#pcreKeywordBase"
            },
            {
              "include": "#pcreCharset"
            }
          ]
        }
      ]
    },
    "pcreKeywordBase": {
      "patterns": [
        {
          "comment": "PCRE escaped left paren",
          "name": "string.regexp.escape.cadence.skill.pcre.metachar strong.cadence.skill.pcre.metachar",
          "match": "\\\\\\\\\\("
        },
        {
          "comment": "PCRE escaped right paren",
          "name": "string.regexp.escape.cadence.skill.pcre.metachar strong.cadence.skill.pcre.metachar",
          "match": "\\\\\\\\\\)"
        },
        {
          "comment": "PCRE escaped left bracket",
          "name": "string.regexp.escape.cadence.skill.pcre.metachar strong.cadence.skill.pcre.metachar",
          "match": "\\\\\\\\\\["
        },
        {
          "comment": "PCRE escaped right bracket",
          "name": "string.regexp.escape.cadence.skill.pcre.metachar strong.cadence.skill.pcre.metachar",
          "match": "\\\\\\\\\\]"
        },
        {
          "comment": "PCRE whitespace character class",
          "name": "string.regexp.escape.cadence.skill.pcre.charclass strong.cadence.skill.pcre.charclass",
          "match": "\\\\\\\\s"
        },
        {
          "comment": "PCRE non-whitespace character class",
          "name": "string.regexp.escape.cadence.skill.pcre.charclass strong.cadence.skill.pcre.charclass",
          "match": "\\\\\\\\S"
        },
        {
          "comment": "PCRE digit character class",
          "name": "string.regexp.escape.cadence.skill.pcre.charclass strong.cadence.skill.pcre.charclass",
          "match": "\\\\\\\\d"
        },
        {
          "comment": "PCRE non-digit character class",
          "name": "string.regexp.escape.cadence.skill.pcre.charclass strong.cadence.skill.pcre.charclass",
          "match": "\\\\\\\\D"
        },
        {
          "comment": "PCRE word character class",
          "name": "string.regexp.escape.cadence.skill.pcre.charclass strong.cadence.skill.pcre.charclass",
          "match": "\\\\\\\\w"
        },
        {
          "comment": "PCRE non-word character class",
          "name": "string.regexp.escape.cadence.skill.pcre.charclass strong.cadence.skill.pcre.charclass",
          "match": "\\\\\\\\W"
        },
        {
          "comment": "PCRE word boundary",
          "name": "string.regexp.escape.cadence.skill.pcre.boundary strong.cadence.skill.pcre.boundary",
          "match": "\\\\\\\\b"
        },
        {
          "comment": "PCRE non-word boundary",
          "name": "string.regexp.escape.cadence.skill.pcre.boundary strong.cadence.skill.pcre.boundary",
          "match": "\\\\\\\\B"
        },
        {
          "comment": "PCRE octal escape sequences",
          "name": "constant.numeric.octal.cadence.skill.pcre.escape strong.cadence.skill.pcre.octal",
          "match": "\\\\\\\\(?:[0-3][0-7]{2}|[0-7]{1,2})"
        },
        {
          "comment": "PCRE other common escapes",
          "name": "string.regexp.escape.cadence.skill.pcre.escape",
          "match": "\\\\\\\\[frnvt.+*?|^$]"
        },
        {
          "comment": "PCRE generic escape",
          "name": "string.regexp.escape.cadence.skill.pcre.escape",
          "match": "\\\\\\\\."
        }
      ]
    },
