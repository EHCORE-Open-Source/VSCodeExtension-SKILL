{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "cadence-skill",
    "scopeName": "source.cadence.skill.function",
    "patterns": [
        {
            "include": "#function"
        }
    ],
    "repository": {
        "function": {
            "patterns": [
                {
                    "comment": "lisp-style function",
                    "match": "\\(\\s*(?i)([a-z][[:word:]]*)\\b",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#builtin_function"
                                }
                            ]
                        }
                    }
                },
                {
                    "comment": "c-style function",
                    "match": "\\b(?i)([a-z][[:word:]]*)\\(",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#builtin_function"
                                },
                                {
                                    "include": "#other_function"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "builtin_function": {
            "patterns": [
                {
                    "include": "#builtin_basic_function"
                },
                {
                    "include": "#builtin_development_function"
                }
            ]
        },
        "other_function": {
            "patterns": [
                {
                    "comment": "other function",
                    "match": "\\b([[:word:]]*)\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.cadence.skill.basic"
                        }
                    }
                }
            ]
        },
        "builtin_basic_function": {
            "patterns": [
                {
                    "include": "#basic_list_function"
                },
                {
                    "include": "#basic_data_structure"
                },
                {
                    "include": "#basic_data_operator_function"
                },
                {
                    "include": "#basic_type_conversion_function"
                },
                {
                    "include": "#basic_string_function"
                },
                {
                    "include": "#basic_arithmetic_function"
                },
                {
                    "include": "#basic_bitwise_operator_function"
                },
                {
                    "include": "#basic_trigonometric_function"
                },
                {
                    "include": "#basic_logical_relational_function"
                },
                {
                    "include": "#basic_flow_control_function"
                },
                {
                    "include": "#basic_input_output_function"
                },
                {
                    "include": "#basic_core_function"
                },
                {
                    "include": "#basic_function_program_structure"
                },
                {
                    "include": "#basic_environment_function"
                },
                {
                    "include": "#basic_namespace_function"
                }
            ]
        },
        "basic_list_function": {
            "patterns": [
                {
                    "comment": "List Functions (Letter a)",
                    "match": "\\b(append1?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "List Functions (Letter c)",
                    "match": "\\b(c[ad]{1,4}r|cons(?:tar)?|copy)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "List Functions (Letter d)",
                    "match": "\\b(dtpr)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "List Functions (Letter l)",
                    "match": "\\b(last|lconc|length|lindex|listp?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "List Functions (Letter n)",
                    "match": "\\b(ncon[cs]|nth(?:cdr|elem)?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "List Functions (Letter p)",
                    "match": "\\b(pairp)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "List Functions (Letter r)",
                    "match": "\\b(range|rem(?:d|dq|q)|remove(?:ListDuplicates)?|reverse|rplac[ad])\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "List Functions (Letter s)",
                    "match": "\\b(setc[ad]r)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "List Functions (Letter t)",
                    "match": "\\b(tailp|tconc)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "List Functions (Letter [xy])",
                    "match": "\\b(xcons|[xy]Coord)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                }
            ]
        },
        "basic_data_structure": {
            "patterns": [
                {
                    "comment": "Data Structures (Letter a)",
                    "match": "\\b(array(?:p|ref)?|ass(?:oc|[qv]))\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Structures (Letter d)",
                    "match": "\\b(declare|def(?:prop|structp?|var))\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Structures (Letter m)",
                    "match": "\\b(make(?:Table|Vector))\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Structures (Letter s)",
                    "match": "\\b(setarray)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Structures (Letter t)",
                    "match": "\\b(tablep|typep?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Structures (Letter v)",
                    "match": "\\b(vectorp?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                }
            ]
        },
        "basic_data_operator_function": {
            "patterns": [
                {
                    "comment": "Data Operator Functions (Letter a)",
                    "match": "\\b(alphaNumCmp)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Operator Functions (Letter c)",
                    "match": "\\b(concat|copyDefstructDeep)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Operator Functions (Letter g)",
                    "match": "\\b(get(?:SG|qq?)?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Operator Functions (Letter i)",
                    "match": "\\b(importSkillVar|integerp)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Operator Functions (Letter o)",
                    "match": "\\b(otherp)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Operator Functions (Letter p)",
                    "match": "\\b(plist|popf|post(?:Array(?:Dec|Inc|Set)|(?:de|in)crement)|pre(?:Array(?:Dec|Inc|Set)|(?:de|in)crement)|pushf|putprop(?:qq?)?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Operator Functions (Letter q)",
                    "match": "\\b(quote)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Operator Functions (Letter r)",
                    "match": "\\b(remprop|rotatef)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Data Operator Functions (Letter s)",
                    "match": "\\b(setf?(?:_(?:arrayref|c[ad]{1,3}r|get(?:SGq?|ShellEnvVar|[dq]|qq)?|last|(?:left|right|top|bottom)Edge|lowerLeft|nth(?:[ce]dr|elem)?|slotValue|upperRight|[xy]Coord|([[:word:]]+)))?|set(?:guard|plist|q|SG)|symbolp|sym(?:eval|strp))\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        },
                        "2": {
                            "name": "strong.cadence.skill.basic"
                        }
                    }
                },
                {
                    "comment": "Data Operator Functions (Extension)",
                    "match": "\\b((?:copy|make)_([[:word:]]+))\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.control.cadence.skill.basic"
                        },
                        "2": {
                            "name": "strong.cadence.skill.basic"
                        }
                    }
                }
            ]
        },
        "basic_type_conversion_function": {
            "patterns": [
                {
                    "comment": "Type Conversion Functions",
                    "match": "\\b(charToInt|intToChar|listToVector|stringTo(?:Function|Symbol|Time)|symbolToString|tableToList|timeTo(?:String|Tm)|tmToTime|vectorToList)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                }
            ]
        },
        "basic_string_function": {
            "patterns": [
                {
                    "comment": "String Functions (Letter b)",
                    "match": "\\b(blankstrp|buildString)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "String Functions (Letter g)",
                    "match": "\\b(getchar)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "String Functions (Letter l)",
                    "match": "\\b(lsprintf)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "String Functions (Letter p)",
                    "match": "\\b(parseString)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "String Functions (Letter r)",
                    "match": "\\b(readstring)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "String Functions (Letter s)",
                    "match": "\\b(sprintf|str(?:n?cat|n?cmp|len|pbrk)|stringp|sub(?:st|string))\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "String Functions (Letter o)",
                    "match": "\\b(outstringp)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "String Functions (Index)",
                    "match": "\\b([nr]?index)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "String Functions (Case)",
                    "match": "\\b((?:lower|upper)Case)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "String Functions (Regular Expression)",
                    "match": "\\b(rex(?:Compile|Execute|Magic|Match(?:Assoc)?List|Matchp|Replace|Substitute))\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "String Functions (PCRE)",
                    "match": "\\b(pcre(?:Compile|Execute|(?:Gen|List)(?:Compile|Exec)OptBits|(?:Get|Set)RecursionLimit|Match(?:Assoc)?List|Matchp|Objectp|PrintLastMatchErr|Replace|SubpatCount|Substitute))\\b",
                    "name": "keyword.control.cadence.skill.basic"
                }
            ]
        },
        "basic_arithmetic_function": {
            "patterns": [
                {
                    "comment": "Arithmetic Functions (Letter a)",
                    "match": "\\b(abs|add1|ato[fi])\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter c)",
                    "match": "\\b(ceiling)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter d)",
                    "match": "\\b(defMathConstants|difference)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter e)",
                    "match": "\\b(evenp|expt?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter f)",
                    "match": "\\b(fix[2p]?|floatp?|floor)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter i)",
                    "match": "\\b(int|is(?:Infinity|NaN))\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter l)",
                    "match": "\\b(leftshift|log(?:10)?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter m)",
                    "match": "\\b(max|min(?:usp?)?|modf?|modulo)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter n)",
                    "match": "\\b(nearlyEqual|negativep)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter o)",
                    "match": "\\b(oddp|onep)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter p)",
                    "match": "\\b(plusp?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter q)",
                    "match": "\\b(quotient)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter r)",
                    "match": "\\b(random|realp|remainder|rightshift|round2?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter s)",
                    "match": "\\b(sort(?:car)?|sqrt|srandom|sub1)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter t)",
                    "match": "\\b(times|truncate)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter x)",
                    "match": "\\b(xdifference|xplus|xquotient|xtimes)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Arithmetic Functions (Letter z)",
                    "match": "\\b(zerop|zxtd)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                }
            ]
        },
        "basic_bitwise_operator_function": {
            "patterns": [
                {
                    "comment": "Bitwise Operator Functions",
                    "match": "\\b(bn?and|(?:setq)?bitfield1?|bn?x?or|bnot)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                }
            ]
        },
        "basic_trigonometric_function": {
            "patterns": [
                {
                    "comment": "Trigonometric Functions",
                    "match": "\\b(a?(?:cos|sin|tan)|atan2)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                }
            ]
        },
        "basic_logical_relational_function": {
            "patterns": [
                {
                    "comment": "Logical and Relational Functions",
                    "match": "\\b(alphalessp|and|compareTime|n?eq(?:ual)?|eqv|geqp|greaterp|leqp|lessp|mem(?:ber|[qv])|null|numberp|or|sxtd)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                }
            ]
        },
        "basic_flow_control_function": {
            "patterns": [
                {
                    "comment": "Flow Control Functions (Letter c)",
                    "match": "\\b(caseq?|catch|cond)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Flow Control Functions (Letter d)",
                    "match": "\\b(decode|do)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Flow Control Functions (Letter e)",
                    "match": "\\b(existss?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Flow Control Functions (Letter f)",
                    "match": "\\b(for(?:all|each)?s?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Flow Control Functions (Letter i)",
                    "match": "\\b(if)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Flow Control Functions (Letter g)",
                    "match": "\\b(go)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Flow Control Functions (Letter m)",
                    "match": "\\b(map(?:c|ca[nr]|con|into|list)?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Flow Control Functions (Letter n)",
                    "match": "\\b(not)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Flow Control Functions (Letter r)",
                    "match": "\\b(regExit(?:After|Before|Proc)|return)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Flow Control Functions (Letter s)",
                    "match": "\\b(setofs?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Flow Control Functions (Letter u)",
                    "match": "\\b(unless)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Flow Control Functions (Letter w)",
                    "match": "\\b(when|while)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                }
            ]
        },
        "basic_input_output_function": {
            "patterns": [
                {
                    "comment": "Input Output Functions (Letter c)",
                    "match": "\\b(close|compress)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter d)",
                    "match": "\\b(display|drain)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter e)",
                    "match": "\\b(ed(?:it?|l)?|encrypt|expandMacroDeep)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter f)",
                    "match": "\\b(file(?:Length|Seek|Tell|TimeModified)|fprintf|fscanf)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter g)",
                    "match": "\\b(get(?:[cs]|_filename|DirFiles|Outstring))\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter i)",
                    "match": "\\b(in(?:clude|file|fo|portp|string)|is(?:Executable|File(?:Encrypted|Name)?|LargeFile|Link|PortAtEOF|Readable|Writable))\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter l)",
                    "match": "\\b(lineread(?:string)?|load(?:i|Port|string)?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter m)",
                    "match": "\\b(makeTempFileName)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter n)",
                    "match": "\\b(newline|numOpenFiles)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter o)",
                    "match": "\\b(openportp|out(?:file|portp|string))\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter p)",
                    "match": "\\b(portp|pp?rint|print(?:f|lev|ln)|putc)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter r)",
                    "match": "\\b(read(?:Table)?|renameFile)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter s)",
                    "match": "\\b(ss?canf|simplifyFilename(?:Unique)?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter t)",
                    "match": "\\b(truename)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Input Output Functions (Letter w)",
                    "match": "\\b(which|write(?:Table)?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                }
            ]
        },
        "basic_core_function": {
            "patterns": [
                {
                    "comment": "Core Functions (Letter a)",
                    "match": "\\b(arglist|assert|atom)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter b)",
                    "match": "\\b(bcdp|booleanp|boundp)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter d)",
                    "match": "\\b(describe)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter f)",
                    "match": "\\b(fdoc)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter g)",
                    "match": "\\b(gc|gensym|get(?:_pname|_string|MuffleWarnings|SkillVersion|Version|Warn))\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter h)",
                    "match": "\\b(help)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter i)",
                    "match": "\\b(in(?:Scheme|Skill)|isVarImported)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter m)",
                    "match": "\\b(makeSymbol|measureTime|muffleWarnings)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter n)",
                    "match": "\\b(needNCells)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter r)",
                    "match": "\\b(restoreFloat)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter s)",
                    "match": "\\b(saveFloat|schemeTopLevelEnv|setPrompts|s?status)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter t)",
                    "match": "\\b(theEnvironment)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Core Functions (Letter u)",
                    "match": "\\b(unbindVar)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                }
            ]
        },
        "basic_function_program_structure": {
            "patterns": [
                {
                    "comment": "Function and Program Structure (Letter a)",
                    "match": "\\b(addDefstructClass|alias|apply|arg[cv])\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Function and Program Structure (Letter b)",
                    "match": "\\b(begin)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Function and Program Structure (Letter c)",
                    "match": "\\b(clearExitProcs)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Function and Program Structure (Letter d)",
                    "match": "\\b(declare(?:(?:SQ)?N)?Lambda|def(?:dynamic|globalfun|ine(?:_syntax)?|macro|setf|un|UserInitProc)|destructuringBind|dynamic(?:Let)?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Function and Program Structure (Letter e)",
                    "match": "\\b(err(?:or|set(?:string)?)?|eval(?:string)?|expandMacro)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Function and Program Structure (Letter f)",
                    "match": "\\b(fboundp|flet|funcall)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Function and Program Structure (Letter g)",
                    "match": "\\b(get(?:d|FnWriteProtect|FunType|VarWriteProtect)?|globalProc)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Function and Program Structure (Letter i)",
                    "match": "\\b(is(?:Callable|Macro)|labels|lambda|let(?:rec|seq)?)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
                    "comment": "Function and Program Structure (Letter m)",
                    "match": "\\b(mprocedure)\\b",
                    "name": "keyword.control.cadence.skill.basic"
                },
                {
