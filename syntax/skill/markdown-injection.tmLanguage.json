{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Cadence SKILL Markdown Code Block",
    "scopeName": "markdown.cadence.skill.codeblock",
    "injectionSelector": "L:text.html.markdown",
    "patterns": [
        {
            "include": "#skill-code-block"
        }
    ],
    "repository": {
        "skill-code-block": {
            "patterns": [
                {
                    "begin": "(^|\\G)(\\s*)(```|~~~)\\s*(?i:(skill|cadence-skill)((\\s+|:|,|\\{|\\?)[^`]*)?$)",
                    "name": "markup.fenced_code.block.markdown",
                    "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
                    "beginCaptures": {
                        "3": {
                            "name": "punctuation.definition.markdown"
                        },
                        "4": {
                            "name": "fenced_code.block.language.markdown"
                        },
                        "5": {
                            "name": "fenced_code.block.language.attributes.markdown"
                        }
                    },
                    "endCaptures": {
                        "3": {
                            "name": "punctuation.definition.markdown"
                        }
                    },
                    "patterns": [
                        {
                            "begin": "(^|\\G)(\\s*)(.*)",
                            "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
                            "contentName": "meta.embedded.block.skill",
                            "patterns": [
                                {
                                    "include": "source.cadence.skill.basic"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    }
}
