{
    "$schema": "https://json-schema.org/draft-07/schema",
    "$id": "https://example.com/cellview",
    "title": "Cell View Creation",
    "description": "The schema validates the minimum requirements for cell view",
    "type": "object",
    "properties": {
        "version": {
            "description": "Define the cellview file format",
            "type": "number",
            "default": 1.0,
            "const": 1.0
        },
        "release": {
            "description": "The release date of the cellview",
            "type": "string",
            "pattern": "^(?:19|2[01])[0-9]{2}/(?:0[1-9]|1[0-2])/(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "author": {
            "description": "The author of the cellview",
            "type": "string"
        },
        "library": {
            "description": "Default imported library name. This field will be overridden by the category's library name setting.",
            "type": "string"
        },
        "database": {
            "description": "Define how Cellview is created.",
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "cell": {
                        "description": "Define cell name. The cell name can be combined with # symbol to create different designs.",
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_$#]*$"
                    },
                    "symbol": {
                        "description": "Define cellview name is symbol.",
                        "type": "object",
                        "properties": {
                            "viewType": {
                                "description": "Define cellview type",
                                "type": "string",
                                "enum": [ "schematic", "schematicSymbol" ]
                            },
                            "creation": {
                                "description": "Define the cellview creation details",
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "type": {
                                            "description": "Define a creation type",
                                            "type": "string",
                                            "enum": [ "hashtag", "group", "shape", "pin", "label", "note", "noteShape", "selectionBox" ]
                                        }
                                    },
                                    "required": [
                                        "type"
                                    ],
                                    "allOf": [
                                        {
                                            "if": {
                                                "properties": {
                                                    "type": {
                                                        "const": "hashtag"
                                                    }
                                                }
                                            },
                                            "then": {
                                                "properties": {
                                                    "hashtag": {
                                                        "type": "array"
                                                    }
                                                },
                                                "required": [
                                                    "hashtag"
                                                ]
                                            }
                                        },
                                        {
                                            "if": {
                                                "properties": {
                                                    "type": {
                                                        "const": "group"
                                                    }
                                                }
                                            },
                                            "then": {
                                                "properties": {
                                                    "groups": {
                                                        "type": "array"
                                                    }
                                                },
                                                "required": [
                                                    "groups"
                                                ]
                                            }
                                        }
                                    ]
                                }
                            }
                        },
                        "required": [
                            "viewType",
                            "creation"
                        ]
                    }
                },
                "required": [
                    "cell"
                ]
            }
        }
    },
    "required": [
        "version",
        "library",
        "database"
    ]
}